#!/usr/bin/env python3
"""`./ccd` — run the CLI straight from a source checkout.

Installed users get the `ccd` console script instead; this stub exists so a
checkout (and `tests/ccd_smoke.sh`, which invokes `$REPO_ROOT/ccd`) can run the
very same code with nothing installed. It is a launcher, not a second
implementation.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ccd_cli.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
