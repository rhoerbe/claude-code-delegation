#!/usr/bin/env bash
# ccd - thin bash CLI for ccd-broker (see PLAN-ccd-v2.md §5.2).
#
# Each subcommand opens a short-lived connection to $CCD_SOCKET, sends one
# line-JSON request, and prints the reply human-readably. `ccd recv` blocks in
# the broker (the socket read here just waits — that is the zero-token park;
# there is no polling loop anywhere in this file).
#
# Subcommands: send, recv, announce, ret, claim, release, ls, dashboard, ping,
# broker start|stop|status.
set -u

CCD_SOCKET="${CCD_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/ccd-${USER:-$(id -un)}.sock}"
CCD_PIDFILE="${CCD_PIDFILE:-${XDG_RUNTIME_DIR:-/tmp}/ccd-${USER:-$(id -un)}.pid}"
CCD_BROKER_LOG="${CCD_PIDFILE%.pid}.log"

# ---------------------------------------------------------------------------
# transport: one line-JSON request/response over $CCD_SOCKET
# ---------------------------------------------------------------------------

_ccd_repo_root() {
  cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
}

# _ccd_rpc <method> [key=value ...]
# Prints the raw JSON reply line to stdout. Exit 0 once a reply line was
# received from the broker (including a broker-side {"ok":false,...}); exit 1
# if the connection itself could not be made or produced no reply.
_ccd_rpc() {
  local method="$1"; shift
  python3 - "$CCD_SOCKET" "$method" "$@" <<'PYEOF'
import json
import socket
import sys

sock_path, method = sys.argv[1], sys.argv[2]
args = {}
for item in sys.argv[3:]:
    k, _, v = item.partition("=")
    args[k] = v

req = json.dumps({"method": method, "args": args}) + "\n"

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(sock_path)
except OSError as e:
    sys.stdout.write(json.dumps({"ok": False, "reason": f"connect failed: {e}"}) + "\n")
    sys.exit(1)

try:
    s.sendall(req.encode("utf-8"))
    buf = b""
    # Blocking read: for `recv` this is the zero-token park. No polling here —
    # the process is simply asleep in the read() syscall until the broker
    # writes a reply (message arrival or its own timeout).
    while b"\n" not in buf:
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
finally:
    s.close()

line = buf.split(b"\n", 1)[0]
if not line:
    sys.stdout.write(json.dumps({"ok": False, "reason": "broker closed connection without a reply"}) + "\n")
    sys.exit(1)
sys.stdout.buffer.write(line + b"\n")
PYEOF
}

# _ccd_fmt <reply-json> <python-body>
# Runs <python-body> with `d` bound to the parsed reply dict. The body decides
# stdout/stderr/exit code (ok:false -> non-zero exit is the convention).
_ccd_fmt() {
  local reply="$1" body="$2"
  python3 -c "
import json, sys
d = json.loads(sys.argv[1])
$body
" "$reply"
}

_ccd_ok_or_err() {
  local reply="$1" okmsg="$2"
  _ccd_fmt "$reply" "
if d.get('ok'):
    print('$okmsg')
else:
    print('error: ' + str(d.get('reason', 'unknown error')), file=sys.stderr)
    sys.exit(1)
"
}

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------

cmd_send() {
  if [ $# -lt 2 ]; then
    echo "usage: ccd send <to> <msg> [-f from]" >&2
    return 2
  fi
  local to="$1" msg="$2" from=""
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) from="${2:-}"; shift 2 ;;
      *) echo "ccd send: unknown argument: $1" >&2; return 2 ;;
    esac
  done
  local reply
  reply="$(_ccd_rpc send "to=$to" "msg=$msg" "from=$from")" || {
    echo "ccd send: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_fmt "$reply" "
if d.get('ok'):
    print('sent (id=' + str(d.get('id')) + ')')
else:
    print('ccd send: ' + str(d.get('reason', 'error')), file=sys.stderr)
    sys.exit(1)
"
}

cmd_recv() {
  local handle="" timeout=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -t) timeout="${2:-}"; shift 2 ;;
      -*) echo "ccd recv: unknown argument: $1" >&2; return 2 ;;
      *)
        if [ -z "$handle" ]; then handle="$1"; shift
        else echo "ccd recv: unexpected argument: $1" >&2; return 2
        fi
        ;;
    esac
  done
  handle="${handle:-${CCD_HANDLE:-}}"
  if [ -z "$handle" ]; then
    echo "ccd recv: no handle given and \$CCD_HANDLE not set" >&2
    return 2
  fi

  local args=(recv "handle=$handle")
  [ -n "$timeout" ] && args+=("timeout=$timeout")

  local reply
  reply="$(_ccd_rpc "${args[@]}")" || {
    echo "ccd recv: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_fmt "$reply" "
if d.get('ok'):
    print(str(d.get('from')) + ': ' + str(d.get('msg')))
elif d.get('reason') == 'timeout':
    print('ccd recv: timeout', file=sys.stderr)
    sys.exit(1)
else:
    print('ccd recv: ' + str(d.get('reason', 'error')), file=sys.stderr)
    sys.exit(1)
"
}

cmd_announce() {
  local handle="" model="" effort="" exclusive=""
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --exclusive) exclusive="1"; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]}"
  case $# in
    3) handle="$1"; model="$2"; effort="$3" ;;
    2) handle="${CCD_HANDLE:-}"; model="$1"; effort="$2" ;;
    *)
      echo "usage: ccd announce [<handle>] <model> <effort>  (\$CCD_HANDLE is the default handle)" >&2
      return 2
      ;;
  esac
  if [ -z "$handle" ]; then
    echo "ccd announce: no handle given and \$CCD_HANDLE not set" >&2
    return 2
  fi
  # Where this session lives, and which transcript is its own. Both are
  # optional and unvalidated; they are the only thing correlating a handle to
  # the transcript `ccd dashboard` reads its status/cost/content from
  # (ADR-0008). $CLAUDE_CODE_SESSION_ID is set inside a Claude Code session and
  # empty anywhere else, in which case the broker keeps whatever it already had.
  #
  # $model here is the CLI's positional slot argument (fable/opus/sonnet/
  # haiku) — sent on the wire as `slot`, broker 1.3's honest name for it
  # (claude-code-delegation#13). The resolved `model` field and `mapping` are
  # left unsent: nothing at this layer can supply them yet (that is phase
  # 2/4's manifest and launcher work), and the broker treats an omitted
  # optional field as "unknown", never as a lie. $CLAUDE_PID is the
  # announcing session's own top-level process id, set inside Claude Code and
  # empty anywhere else — the broker treats an empty pid as "no pid", exactly
  # like a plain shell participant, so it is never reaped for staleness.
  local rpc_args=(announce "handle=$handle" "slot=$model" "effort=$effort"
                  "cwd=$PWD" "session=${CLAUDE_CODE_SESSION_ID:-}"
                  "pid=${CLAUDE_PID:-}")
  [ -n "$exclusive" ] && rpc_args+=("exclusive=1")

  local reply
  reply="$(_ccd_rpc "${rpc_args[@]}")"
  [ $? -eq 0 ] || {
    echo "ccd announce: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_ok_or_err "$reply" "announced $handle ($model/$effort)"
}

cmd_ret() {
  if [ $# -gt 1 ]; then
    echo "usage: ccd ret [<handle>]  (\$CCD_HANDLE is the default handle)" >&2
    return 2
  fi
  local handle="${1:-${CCD_HANDLE:-}}"
  if [ -z "$handle" ]; then
    echo "ccd ret: no handle given and \$CCD_HANDLE not set" >&2
    return 2
  fi
  local reply
  reply="$(_ccd_rpc retire "handle=$handle")" || {
    echo "ccd ret: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_ok_or_err "$reply" "retired $handle"
}

# ccd claim <worker> [<dispatcher>] [--force]   ($CCD_HANDLE is the dispatcher)
cmd_claim() {
  local force="" args=() worker="" owner=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force|-f) force="1"; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  case ${#args[@]} in
    2) worker="${args[0]}"; owner="${args[1]}" ;;
    1) worker="${args[0]}"; owner="${CCD_HANDLE:-}" ;;
    *)
      echo "usage: ccd claim <worker> [<dispatcher>] [--force]  (\$CCD_HANDLE is the default dispatcher)" >&2
      return 2
      ;;
  esac
  if [ -z "$owner" ]; then
    echo "ccd claim: no dispatcher given and \$CCD_HANDLE not set" >&2
    return 2
  fi
  local reply
  if [ -n "$force" ]; then
    reply="$(_ccd_rpc claim "handle=$worker" "owner=$owner" "force=1")"
  else
    reply="$(_ccd_rpc claim "handle=$worker" "owner=$owner")"
  fi
  [ $? -eq 0 ] || { echo "ccd claim: broker unreachable at $CCD_SOCKET" >&2; return 1; }
  _ccd_ok_or_err "$reply" "claimed $worker for $owner"
}

# ccd release <worker> [--force]
cmd_release() {
  local force="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --force|-f) force="1"; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  if [ ${#args[@]} -ne 1 ]; then
    echo "usage: ccd release <worker> [--force]" >&2
    return 2
  fi
  local worker="${args[0]}" owner="${CCD_HANDLE:-}" reply
  if [ -n "$force" ]; then
    reply="$(_ccd_rpc release "handle=$worker" "owner=$owner" "force=1")"
  else
    reply="$(_ccd_rpc release "handle=$worker" "owner=$owner")"
  fi
  [ $? -eq 0 ] || { echo "ccd release: broker unreachable at $CCD_SOCKET" >&2; return 1; }
  _ccd_ok_or_err "$reply" "released $worker"
}

# ccd ls: the roster, plus what the broker cannot know on its own.
#
# Columns 1-4 (handle/slot/effort/owner) keep their pre-1.3 positions on
# purpose — anything parsing this output by column index (hosting's
# ccd_overview.py, claude-code-delegation#13) stays working unmodified.
# model/pid/status/drift are appended, not inserted, for the same reason —
# and deliberately with NO header row: a column-index consumer here treats
# every non-blank, non-"(no workers announced)" line as one worker's data
# (that is the whole reason 3-vs-4-column pre-1.1.0/1.1.0 rosters were both
# just "accepted" rather than version-sniffed), so a header would misparse
# as a fake worker literally named "HANDLE".
#
# pid/status come straight from the roster reply (the broker already
# resolved liveness — see broker.py's module docstring, "Liveness and
# reaping"). drift is NOT the broker's to know (ADR-0003: it holds no
# transcript access) — this is computed here, the same way `ccd dashboard`
# does, by reading the announced session's own transcript
# (ccd_dashboard.transcript, ADR-0008) and comparing what it shows against
# what was declared. The roster itself is never touched by what is found.
cmd_ls() {
  local reply
  reply="$(_ccd_rpc roster)" || {
    echo "ccd ls: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  local root
  root="$(_ccd_repo_root)"
  PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" python3 - "$reply" <<'PYEOF'
import json
import sys

from ccd_dashboard import transcript as tx

d = json.loads(sys.argv[1])
if not d.get("ok"):
    print("ccd ls: " + str(d.get("reason", "error")), file=sys.stderr)
    sys.exit(1)

workers = d.get("workers") or []
if not workers:
    print("(no workers announced)")
    sys.exit(0)

for w in workers:
    handle = str(w.get("handle"))
    slot = w.get("slot") or "-"
    effort = w.get("effort") or "-"
    owner = w.get("owner") or "-"
    model = w.get("model") or "-"
    pid = w.get("pid")
    alive = w.get("alive")
    if pid is None:
        pid_col, status = "-", "-"
    else:
        pid_col, status = str(pid), ("up" if alive else "dead")

    # Observed values come from the session's own transcript, never from the
    # broker (ADR-0003/0008) — located the same way `ccd dashboard` does.
    # `!` never fires on a field that was never declared: an undeclared
    # `model` (nothing upstream can supply it yet) is not a discrepancy,
    # it's simply unknown.
    drift = ""
    located = tx.locate(w.get("cwd"), w.get("session"))
    if located:
        facts = tx.parse(located.path)
        declared_effort, declared_model = w.get("effort") or None, w.get("model") or None
        if facts.effort and declared_effort and facts.effort != declared_effort:
            drift = "!"
        elif facts.model and declared_model and facts.model != declared_model:
            drift = "!"

    print("\t".join([handle, slot, effort, owner, model, pid_col, status, drift]))
PYEOF
}

# ccd dashboard [--scope <handle>] [--json] [--write <path>] [--rates <file>]
#
# Read-only (ADR-0008): metadata for every announced handle, and the one
# content line of the scoped handle only. The roster comes from the broker;
# everything richer than the roster comes from each session's own transcript,
# never from the broker, which holds no content at all (ADR-0003).
cmd_dashboard() {
  local py_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --scope|--write|--rates)
        # `shift 2` with nothing to shift would spin forever under `set -u`.
        if [ $# -lt 2 ]; then
          echo "ccd dashboard: $1 needs a value" >&2
          return 2
        fi
        py_args+=("$1" "$2"); shift 2 ;;
      --json) py_args+=(--json); shift ;;
      -h|--help)
        echo "usage: ccd dashboard [--scope <handle>] [--json] [--write <path>] [--rates <file>]"
        return 0 ;;
      *) echo "ccd dashboard: unknown argument: $1" >&2; return 2 ;;
    esac
  done

  local reply
  reply="$(_ccd_rpc roster)" || {
    echo "ccd dashboard: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }

  local root
  root="$(_ccd_repo_root)"
  printf '%s\n' "$reply" | PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m ccd_dashboard "${py_args[@]+"${py_args[@]}"}"
}

cmd_ping() {
  local reply
  reply="$(_ccd_rpc ping)" || {
    echo "down (broker unreachable at $CCD_SOCKET)" >&2
    return 1
  }
  _ccd_fmt "$reply" "
if d.get('ok'):
    line = 'ok (ccd-broker ' + str(d.get('version', '?')) + ')'
    started = d.get('started_at')
    if started:
        import time as _t
        up = max(0, int(_t.time() - float(started)))
        h, rem = divmod(up, 3600)
        line += ' up ' + (str(h) + 'h' if h else '') + str(rem // 60) + 'm'
    print(line)
else:
    print('ccd ping: ' + str(d.get('reason', 'error')), file=sys.stderr)
    sys.exit(1)
"
}

# ---------------------------------------------------------------------------
# broker process management
# ---------------------------------------------------------------------------

cmd_broker() {
  local sub="${1:-}"
  case "$sub" in
    start) _broker_start ;;
    stop) _broker_stop ;;
    status) _broker_status ;;
    *) echo "usage: ccd broker start|stop|status" >&2; return 2 ;;
  esac
}

_broker_start() {
  if cmd_ping >/dev/null 2>&1; then
    echo "ccd broker: already running (socket $CCD_SOCKET)"
    return 0
  fi
  local root
  root="$(_ccd_repo_root)"
  mkdir -p "$(dirname "$CCD_PIDFILE")"
  PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" \
    nohup python3 -m ccd_broker >"$CCD_BROKER_LOG" 2>&1 &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  echo "$pid" > "$CCD_PIDFILE"

  # Poll-wait for it to come up, not a fixed sleep (avoids racing slow starts
  # and avoids wasting time on fast ones).
  local waited=0
  while [ "$waited" -lt 50 ]; do  # up to ~5s
    if cmd_ping >/dev/null 2>&1; then
      echo "ccd broker: started (pid $pid, socket $CCD_SOCKET)"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  echo "ccd broker: launched pid $pid but it did not answer ping within 5s (see $CCD_BROKER_LOG)" >&2
  return 1
}

_broker_stop() {
  if [ ! -f "$CCD_PIDFILE" ]; then
    if cmd_ping >/dev/null 2>&1; then
      echo "ccd broker: running but no pidfile at $CCD_PIDFILE — cannot stop automatically" >&2
      return 1
    fi
    echo "ccd broker: not running"
    return 0
  fi

  local pid
  pid="$(cat "$CCD_PIDFILE" 2>/dev/null || true)"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$CCD_PIDFILE"
    echo "ccd broker: not running (stale pidfile removed)"
    return 0
  fi

  kill -TERM "$pid" 2>/dev/null

  local waited=0
  while [ "$waited" -lt 50 ]; do  # up to ~5s
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
    waited=$((waited + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    echo "ccd broker: pid $pid did not exit within 5s after SIGTERM" >&2
    return 1
  fi
  rm -f "$CCD_PIDFILE"
  echo "ccd broker: stopped (pid $pid)"
}

_broker_status() {
  if cmd_ping >/dev/null 2>&1; then
    echo "up"
    return 0
  fi
  echo "down"
  return 1
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

_usage() {
  cat <<'EOF'
usage: ccd <subcommand> [args]

  ccd send <to> <msg> [-f from]
  ccd recv [<handle>] [-t timeout]      ($CCD_HANDLE is the default handle)
  ccd announce [<handle>] <model> <effort> [--exclusive]
  ccd ret [<handle>]
  ccd claim <worker> [<dispatcher>] [--force]
  ccd release <worker> [--force]
  ccd ls
  ccd dashboard [--scope <handle>] [--json] [--write <path>] [--rates <file>]
  ccd ping
  ccd broker start|stop|status

env: CCD_SOCKET, CCD_HANDLE, CCD_PIDFILE
EOF
}

main() {
  local cmd="${1:-}"
  if [ -z "$cmd" ]; then
    _usage >&2
    return 2
  fi
  shift

  case "$cmd" in
    send) cmd_send "$@" ;;
    recv) cmd_recv "$@" ;;
    announce) cmd_announce "$@" ;;
    ret) cmd_ret "$@" ;;
    claim) cmd_claim "$@" ;;
    release) cmd_release "$@" ;;
    ls) cmd_ls "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    ping) cmd_ping "$@" ;;
    broker) cmd_broker "$@" ;;
    -h|--help|help) _usage ;;
    *)
      echo "ccd: unknown subcommand: $cmd" >&2
      _usage >&2
      return 2
      ;;
  esac
}

main "$@"
