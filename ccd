#!/usr/bin/env bash
# ccd - thin bash CLI for ccd-broker (see PLAN-ccd-v2.md §5.2).
#
# Each subcommand opens a short-lived connection to $CCD_SOCKET, sends one
# line-JSON request, and prints the reply human-readably. `ccd recv` blocks in
# the broker (the socket read here just waits — that is the zero-token park;
# there is no polling loop anywhere in this file).
#
# Subcommands: send, recv, announce, ret, ls, ping, broker start|stop|status.
set -u

CCD_SOCKET="${CCD_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/ccd-${USER:-$(id -un)}.sock}"
CCD_PIDFILE="${CCD_PIDFILE:-${XDG_RUNTIME_DIR:-/tmp}/ccd-${USER:-$(id -un)}.pid}"
CCD_BROKER_LOG="${CCD_PIDFILE%.pid}.log"

# ---------------------------------------------------------------------------
# transport: one line-JSON request/response over $CCD_SOCKET
# ---------------------------------------------------------------------------

_ccd_repo_root() {
  cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
}

# _ccd_rpc <method> [key=value ...]
# Prints the raw JSON reply line to stdout. Exit 0 once a reply line was
# received from the broker (including a broker-side {"ok":false,...}); exit 1
# if the connection itself could not be made or produced no reply.
_ccd_rpc() {
  local method="$1"; shift
  python3 - "$CCD_SOCKET" "$method" "$@" <<'PYEOF'
import json
import socket
import sys

sock_path, method = sys.argv[1], sys.argv[2]
args = {}
for item in sys.argv[3:]:
    k, _, v = item.partition("=")
    args[k] = v

req = json.dumps({"method": method, "args": args}) + "\n"

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(sock_path)
except OSError as e:
    sys.stdout.write(json.dumps({"ok": False, "reason": f"connect failed: {e}"}) + "\n")
    sys.exit(1)

try:
    s.sendall(req.encode("utf-8"))
    buf = b""
    # Blocking read: for `recv` this is the zero-token park. No polling here —
    # the process is simply asleep in the read() syscall until the broker
    # writes a reply (message arrival or its own timeout).
    while b"\n" not in buf:
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
finally:
    s.close()

line = buf.split(b"\n", 1)[0]
if not line:
    sys.stdout.write(json.dumps({"ok": False, "reason": "broker closed connection without a reply"}) + "\n")
    sys.exit(1)
sys.stdout.buffer.write(line + b"\n")
PYEOF
}

# _ccd_fmt <reply-json> <python-body>
# Runs <python-body> with `d` bound to the parsed reply dict. The body decides
# stdout/stderr/exit code (ok:false -> non-zero exit is the convention).
_ccd_fmt() {
  local reply="$1" body="$2"
  python3 -c "
import json, sys
d = json.loads(sys.argv[1])
$body
" "$reply"
}

_ccd_ok_or_err() {
  local reply="$1" okmsg="$2"
  _ccd_fmt "$reply" "
if d.get('ok'):
    print('$okmsg')
else:
    print('error: ' + str(d.get('reason', 'unknown error')), file=sys.stderr)
    sys.exit(1)
"
}

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------

cmd_send() {
  if [ $# -lt 2 ]; then
    echo "usage: ccd send <to> <msg> [-f from]" >&2
    return 2
  fi
  local to="$1" msg="$2" from=""
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) from="${2:-}"; shift 2 ;;
      *) echo "ccd send: unknown argument: $1" >&2; return 2 ;;
    esac
  done
  local reply
  reply="$(_ccd_rpc send "to=$to" "msg=$msg" "from=$from")" || {
    echo "ccd send: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_fmt "$reply" "
if d.get('ok'):
    print('sent (id=' + str(d.get('id')) + ')')
else:
    print('ccd send: ' + str(d.get('reason', 'error')), file=sys.stderr)
    sys.exit(1)
"
}

cmd_recv() {
  local handle="" timeout=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -t) timeout="${2:-}"; shift 2 ;;
      -*) echo "ccd recv: unknown argument: $1" >&2; return 2 ;;
      *)
        if [ -z "$handle" ]; then handle="$1"; shift
        else echo "ccd recv: unexpected argument: $1" >&2; return 2
        fi
        ;;
    esac
  done
  handle="${handle:-${CCD_HANDLE:-}}"
  if [ -z "$handle" ]; then
    echo "ccd recv: no handle given and \$CCD_HANDLE not set" >&2
    return 2
  fi

  local args=(recv "handle=$handle")
  [ -n "$timeout" ] && args+=("timeout=$timeout")

  local reply
  reply="$(_ccd_rpc "${args[@]}")" || {
    echo "ccd recv: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_fmt "$reply" "
if d.get('ok'):
    print(str(d.get('from')) + ': ' + str(d.get('msg')))
elif d.get('reason') == 'timeout':
    print('ccd recv: timeout', file=sys.stderr)
    sys.exit(1)
else:
    print('ccd recv: ' + str(d.get('reason', 'error')), file=sys.stderr)
    sys.exit(1)
"
}

cmd_announce() {
  local handle="" model="" effort=""
  case $# in
    3) handle="$1"; model="$2"; effort="$3" ;;
    2) handle="${CCD_HANDLE:-}"; model="$1"; effort="$2" ;;
    *)
      echo "usage: ccd announce [<handle>] <model> <effort>  (\$CCD_HANDLE is the default handle)" >&2
      return 2
      ;;
  esac
  if [ -z "$handle" ]; then
    echo "ccd announce: no handle given and \$CCD_HANDLE not set" >&2
    return 2
  fi
  local reply
  reply="$(_ccd_rpc announce "handle=$handle" "model=$model" "effort=$effort")" || {
    echo "ccd announce: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_ok_or_err "$reply" "announced $handle ($model/$effort)"
}

cmd_ret() {
  if [ $# -gt 1 ]; then
    echo "usage: ccd ret [<handle>]  (\$CCD_HANDLE is the default handle)" >&2
    return 2
  fi
  local handle="${1:-${CCD_HANDLE:-}}"
  if [ -z "$handle" ]; then
    echo "ccd ret: no handle given and \$CCD_HANDLE not set" >&2
    return 2
  fi
  local reply
  reply="$(_ccd_rpc retire "handle=$handle")" || {
    echo "ccd ret: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_ok_or_err "$reply" "retired $handle"
}

# ccd claim <worker> [<dispatcher>] [--force]   ($CCD_HANDLE is the dispatcher)
cmd_claim() {
  local force="" args=() worker="" owner=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force|-f) force="1"; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  case ${#args[@]} in
    2) worker="${args[0]}"; owner="${args[1]}" ;;
    1) worker="${args[0]}"; owner="${CCD_HANDLE:-}" ;;
    *)
      echo "usage: ccd claim <worker> [<dispatcher>] [--force]  (\$CCD_HANDLE is the default dispatcher)" >&2
      return 2
      ;;
  esac
  if [ -z "$owner" ]; then
    echo "ccd claim: no dispatcher given and \$CCD_HANDLE not set" >&2
    return 2
  fi
  local reply
  if [ -n "$force" ]; then
    reply="$(_ccd_rpc claim "handle=$worker" "owner=$owner" "force=1")"
  else
    reply="$(_ccd_rpc claim "handle=$worker" "owner=$owner")"
  fi
  [ $? -eq 0 ] || { echo "ccd claim: broker unreachable at $CCD_SOCKET" >&2; return 1; }
  _ccd_ok_or_err "$reply" "claimed $worker for $owner"
}

# ccd release <worker> [--force]
cmd_release() {
  local force="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --force|-f) force="1"; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  if [ ${#args[@]} -ne 1 ]; then
    echo "usage: ccd release <worker> [--force]" >&2
    return 2
  fi
  local worker="${args[0]}" owner="${CCD_HANDLE:-}" reply
  if [ -n "$force" ]; then
    reply="$(_ccd_rpc release "handle=$worker" "owner=$owner" "force=1")"
  else
    reply="$(_ccd_rpc release "handle=$worker" "owner=$owner")"
  fi
  [ $? -eq 0 ] || { echo "ccd release: broker unreachable at $CCD_SOCKET" >&2; return 1; }
  _ccd_ok_or_err "$reply" "released $worker"
}

cmd_ls() {
  local reply
  reply="$(_ccd_rpc roster)" || {
    echo "ccd ls: broker unreachable at $CCD_SOCKET" >&2
    return 1
  }
  _ccd_fmt "$reply" "
if not d.get('ok'):
    print('ccd ls: ' + str(d.get('reason', 'error')), file=sys.stderr)
    sys.exit(1)
workers = d.get('workers') or []
if not workers:
    print('(no workers announced)')
else:
    for w in workers:
        owner = w.get('owner') or '-'
        print(str(w.get('handle')) + '\t' + str(w.get('model')) + '\t'
              + str(w.get('effort')) + '\t' + str(owner))
"
}

cmd_ping() {
  local reply
  reply="$(_ccd_rpc ping)" || {
    echo "down (broker unreachable at $CCD_SOCKET)" >&2
    return 1
  }
  _ccd_fmt "$reply" "
if d.get('ok'):
    line = 'ok (ccd-broker ' + str(d.get('version', '?')) + ')'
    started = d.get('started_at')
    if started:
        import time as _t
        up = max(0, int(_t.time() - float(started)))
        h, rem = divmod(up, 3600)
        line += ' up ' + (str(h) + 'h' if h else '') + str(rem // 60) + 'm'
    print(line)
else:
    print('ccd ping: ' + str(d.get('reason', 'error')), file=sys.stderr)
    sys.exit(1)
"
}

# ---------------------------------------------------------------------------
# broker process management
# ---------------------------------------------------------------------------

cmd_broker() {
  local sub="${1:-}"
  case "$sub" in
    start) _broker_start ;;
    stop) _broker_stop ;;
    status) _broker_status ;;
    *) echo "usage: ccd broker start|stop|status" >&2; return 2 ;;
  esac
}

_broker_start() {
  if cmd_ping >/dev/null 2>&1; then
    echo "ccd broker: already running (socket $CCD_SOCKET)"
    return 0
  fi
  local root
  root="$(_ccd_repo_root)"
  mkdir -p "$(dirname "$CCD_PIDFILE")"
  PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" \
    nohup python3 -m ccd_broker >"$CCD_BROKER_LOG" 2>&1 &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  echo "$pid" > "$CCD_PIDFILE"

  # Poll-wait for it to come up, not a fixed sleep (avoids racing slow starts
  # and avoids wasting time on fast ones).
  local waited=0
  while [ "$waited" -lt 50 ]; do  # up to ~5s
    if cmd_ping >/dev/null 2>&1; then
      echo "ccd broker: started (pid $pid, socket $CCD_SOCKET)"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  echo "ccd broker: launched pid $pid but it did not answer ping within 5s (see $CCD_BROKER_LOG)" >&2
  return 1
}

_broker_stop() {
  if [ ! -f "$CCD_PIDFILE" ]; then
    if cmd_ping >/dev/null 2>&1; then
      echo "ccd broker: running but no pidfile at $CCD_PIDFILE — cannot stop automatically" >&2
      return 1
    fi
    echo "ccd broker: not running"
    return 0
  fi

  local pid
  pid="$(cat "$CCD_PIDFILE" 2>/dev/null || true)"
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$CCD_PIDFILE"
    echo "ccd broker: not running (stale pidfile removed)"
    return 0
  fi

  kill -TERM "$pid" 2>/dev/null

  local waited=0
  while [ "$waited" -lt 50 ]; do  # up to ~5s
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
    waited=$((waited + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    echo "ccd broker: pid $pid did not exit within 5s after SIGTERM" >&2
    return 1
  fi
  rm -f "$CCD_PIDFILE"
  echo "ccd broker: stopped (pid $pid)"
}

_broker_status() {
  if cmd_ping >/dev/null 2>&1; then
    echo "up"
    return 0
  fi
  echo "down"
  return 1
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

_usage() {
  cat <<'EOF'
usage: ccd <subcommand> [args]

  ccd send <to> <msg> [-f from]
  ccd recv [<handle>] [-t timeout]      ($CCD_HANDLE is the default handle)
  ccd announce [<handle>] <model> <effort>
  ccd ret [<handle>]
  ccd claim <worker> [<dispatcher>] [--force]
  ccd release <worker> [--force]
  ccd ls
  ccd ping
  ccd broker start|stop|status

env: CCD_SOCKET, CCD_HANDLE, CCD_PIDFILE
EOF
}

main() {
  local cmd="${1:-}"
  if [ -z "$cmd" ]; then
    _usage >&2
    return 2
  fi
  shift

  case "$cmd" in
    send) cmd_send "$@" ;;
    recv) cmd_recv "$@" ;;
    announce) cmd_announce "$@" ;;
    ret) cmd_ret "$@" ;;
    claim) cmd_claim "$@" ;;
    release) cmd_release "$@" ;;
    ls) cmd_ls "$@" ;;
    ping) cmd_ping "$@" ;;
    broker) cmd_broker "$@" ;;
    -h|--help|help) _usage ;;
    *)
      echo "ccd: unknown subcommand: $cmd" >&2
      _usage >&2
      return 2
      ;;
  esac
}

main "$@"
